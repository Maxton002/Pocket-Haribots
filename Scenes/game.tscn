[sub_resource type="GDScript" id="GDScript_bhunq"]
resource_name = "typeChart"
script/source = "extends Button

@export var hover_scale: Vector2 = Vector2(3.5, 3.5)
@export var scale_duration: float = 0.15
@export var hover_z_index: int = 20

var default_scale: Vector2 = Vector2.ONE
var default_z_index: int = 0
var tween: Tween

func _ready() -> void:
	default_z_index = z_index
	
	# Set pivot to the top-right corner so it scales downward and to the left
	pivot_offset = Vector2(size.x, 0)
	resized.connect(func(): pivot_offset = Vector2(size.x, 0))

func _on_mouse_entered() -> void:
	z_index = hover_z_index
	_animate_scale(hover_scale)

func _on_mouse_exited() -> void:
	z_index = default_z_index
	_animate_scale(default_scale)

func _animate_scale(target_scale: Vector2) -> void:
	if tween:
		tween.kill()
		
	tween = create_tween().set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(self, \"scale\", target_scale, scale_duration)
"

