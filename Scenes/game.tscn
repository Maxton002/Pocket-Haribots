[sub_resource type="GDScript" id="GDScript_g2dxt"]
resource_name = "Main"
script/source = "extends Node2D

# Nodes & Exports
@onready var streak_label: Label = $StreakLabel
@onready var round_label: Label = $Round
@onready var quota_label: Label = $Quota
@onready var note_label: RichTextLabel = $NoteLabel
@onready var cards: Control = $Control
@onready var timer: Timer = $Timer
@onready var timer_label: Label = $TextureProgressBar/Label
@onready var circular_bar: TextureProgressBar = $TextureProgressBar
@onready var color_rect: ColorRect = ColorRect.new()

@onready var results_panel: Control = $ResultsCanvas/ResultsPanel
@onready var correct_label: Label = $ResultsCanvas/ResultsPanel/VBoxContainer/CorrectLabel
@onready var penalty_label: Label = $ResultsCanvas/ResultsPanel/VBoxContainer/PenaltyLabel
@onready var last_round_label: Label = $ResultsCanvas/ResultsPanel/VBoxContainer/RoundLabel
@onready var final_label: Label = $ResultsCanvas/ResultsPanel/VBoxContainer/FinalScoreLabel
@onready var button_label: Button = $ResultsCanvas/ResultsPanel/FinalButton

@onready var fire_b: CardButton = $Control/FireB
@onready var water_b: CardButton = $Control/WaterB
@onready var grass_b: CardButton = $Control/GrassB
@onready var divine_b: CardButton = $Control/DivineB
@onready var electric_b: CardButton = $Control/ElectricB
@onready var dark_b: CardButton = $Control/DarkB

@onready var correctSFX = $SFX/Correct
@onready var wrongSFX = $SFX/Wrong
@onready var winSFX = $SFX/Win
@onready var failSFX = $SFX/Fail
@onready var timeSFX = $SFX/TimeLow
@onready var cdSFX = $SFX/Countdown
@onready var swapSFX = $SFX/Swap

@export_group(\"Round & Queue Layout\")
@export var default_game_time: float = 60.0
@export var base_quota: int = 2000
@export var ghost_trigger_time: float = 15.0
@export var max_elements: int = 5
@export var spacing: float = 200.0
@export var start_x: float = 200.0
@export var start_y: float = 250.0
@export var is_ghost: bool = false

@export_group(\"Modifier Probabilities & Tuning\")
@export var reverse_chance: float = 0.25
@export var armor_chance: float = 0.20
@export var time_bonus_chance: float = 0.12
@export var time_bonus_amount: float = 2.0
@export var shuffle_interval: int = 8
@export var overdrive_duration: float = 5.0

# Resources & Element Tables
const Ghost_babybuster: Texture2D = preload(\"res://Assets/Haribots/Group 480.png\")
const Ghost_popstron: Texture2D = preload(\"res://Assets/Haribots/Group 482.png\")
const Ghost_siborg: Texture2D = preload(\"res://Assets/Haribots/Group 481.png\")
const Ghost_ceo: Texture2D = preload(\"res://Assets/Haribots/Group 483.png\")
const Ghost_honeydroid: Texture2D = preload(\"res://Assets/Haribots/Group 484.png\")
const Ghost_fundyboo: Texture2D = preload(\"res://Assets/Haribots/Group 485.png\")

const Normal_babybuster: Texture2D = preload(\"res://Assets/Haribots/Green 2.png\")
const Normal_popstron: Texture2D = preload(\"res://Assets/Haribots/Blue 3.png\")
const Normal_siborg: Texture2D = preload(\"res://Assets/Haribots/Red 2.png\")
const Normal_ceo: Texture2D = preload(\"res://Assets/Haribots/Main 3.png\")
const Normal_honeydroid: Texture2D = preload(\"res://Assets/Haribots/Yellow 2.png\")
const Normal_fundyboo: Texture2D = preload(\"res://Assets/Haribots/FUNDYBOO.png\")

var babybuster = preload(\"res://Scenes/babybuster.tscn\")
var popstron = preload(\"res://Scenes/popstron.tscn\")
var siborg = preload(\"res://Scenes/siborg.tscn\")
var ceo = preload(\"res://Scenes/ceo.tscn\")
var honeydroid = preload(\"res://Scenes/honeydroid.tscn\")
var fundyboo = preload(\"res://Scenes/fundyboo.tscn\")

@onready var normal_map: Dictionary = {
	babybuster: Normal_babybuster,
	popstron: Normal_popstron,
	siborg: Normal_siborg,
	ceo: Normal_ceo,
	honeydroid: Normal_honeydroid,
	fundyboo: Normal_fundyboo
}

@onready var ghost_map: Dictionary = {
	babybuster: Ghost_babybuster,
	popstron: Ghost_popstron,
	siborg: Ghost_siborg,
	ceo: Ghost_ceo,
	honeydroid: Ghost_honeydroid,
	fundyboo: Ghost_fundyboo
}

const BEATS_MAP = {
	\"Fire\": \"Water\",
	\"Water\": \"Grass\",
	\"Grass\": \"Fire\",
	\"Divine\": \"Electric\",
	\"Electric\": \"Dark\",
	\"Dark\": \"Divine\"
}

const LOSES_TO_MAP = {
	\"Fire\": \"Grass\",
	\"Water\": \"Fire\",
	\"Grass\": \"Water\",
	\"Divine\": \"Dark\",
	\"Electric\": \"Divine\",
	\"Dark\": \"Electric\"
}

# Game State
var list = [babybuster, popstron, siborg, ceo, honeydroid, fundyboo]
var active_queue: Array[Node2D] = []
var last_spawn = null

var score: int = 0
var quota: int = 2000
var correct_picks: int = 0
var overdrive_picks: int = 0
var wrong_picks: int = 0
var base_points_per_correct: int = 100
var penalty_per_wrong: int = 25
var rounds: int = 1
var next: bool = false
var is_in_prep_phase: bool = false

var streak: int = 0
var clears_since_shuffle: int = 0
var is_overdrive: bool = false
var overdrive_time_left: float = 0.0
var overdrive_threshold: int = 10
var overdrive_pulse_tween: Tween

var button_list: Array[CardButton] = []
var original_button_positions: Dictionary = {}
var slot_buttons: Array[CardButton] = []
var button_elements: Dictionary = {}

# Lifecycle & Round Flow
func _ready() -> void:
	color_rect.color = Color(0, 0, 0, 0)
	color_rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	color_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(color_rect)
	
	button_list = [fire_b, water_b, grass_b, divine_b, electric_b, dark_b]
	slot_buttons = button_list.duplicate()
	button_elements = {
		fire_b: \"Fire\",
		water_b: \"Water\",
		grass_b: \"Grass\",
		divine_b: \"Divine\",
		electric_b: \"Electric\",
		dark_b: \"Dark\"
	}
	for btn in button_list:
		if is_instance_valid(btn):
			original_button_positions[btn] = btn.position
	
	# Set min/max before value so Godot doesn't clamp the progress bar
	circular_bar.min_value = 0.0
	circular_bar.max_value = default_game_time
	circular_bar.value = default_game_time
	timer_label.text = \"%.1f\" % default_game_time
	
	quota = base_quota
	quota_label.text = \"Quota: \" + str(quota)
	round_label.text = \"Round - \" + str(rounds)
	results_panel.hide()
	streak_label.hide()
	update_notes_ui()
	
	await start_prep_phase(5.0)
	start_new_game()

func _unhandled_input(event: InputEvent) -> void:
	if is_in_prep_phase or timer.is_stopped():
		return
	if event is InputEventKey and event.pressed and not event.echo:
		# Showcase / playtest shortcuts (active only in debug/editor builds)
		if OS.is_debug_build():
			match event.keycode:
				KEY_N:
					timer.stop()
					next_game()
					get_viewport().set_input_as_handled()
					return
				KEY_O:
					streak = overdrive_threshold
					activate_overdrive()
					get_viewport().set_input_as_handled()
					return
				KEY_G:
					is_ghost = true
					timeSFX.play()
					apply_ghost_mode_to_all()
					get_viewport().set_input_as_handled()
					return
				KEY_S:
					shuffle_two_buttons()
					get_viewport().set_input_as_handled()
					return
				KEY_T:
					timer.start(3.0)
					get_viewport().set_input_as_handled()
					return

		var slot_idx: int = -1
		match event.keycode:
			KEY_1, KEY_KP_1: slot_idx = 0
			KEY_2, KEY_KP_2: slot_idx = 1
			KEY_3, KEY_KP_3: slot_idx = 2
			KEY_4, KEY_KP_4: slot_idx = 3
			KEY_5, KEY_KP_5: slot_idx = 4
			KEY_6, KEY_KP_6: slot_idx = 5
		
		if slot_idx >= 0 and slot_idx < slot_buttons.size():
			var btn: CardButton = slot_buttons[slot_idx]
			if is_instance_valid(btn) and button_elements.has(btn):
				animate_button_press(btn)
				process_furthest_left(button_elements[btn])
				get_viewport().set_input_as_handled()

func _process(delta: float) -> void:
	if is_in_prep_phase:
		circular_bar.min_value = 0.0
		circular_bar.max_value = default_game_time
		circular_bar.value = default_game_time
		timer_label.text = \"%.1f\" % default_game_time
		return

	if not timer.is_stopped():
		var time_left: float = timer.time_left
		circular_bar.value = time_left
		timer_label.text = \"%.1f\" % time_left
		
		if is_overdrive:
			overdrive_time_left -= delta
			if overdrive_time_left <= 0.0:
				end_overdrive()
		
		# Panic phase: Ghost Mode activates in the final seconds of Round 2+
		if rounds >= 2 and time_left <= ghost_trigger_time and not is_ghost:
			is_ghost = true
			timeSFX.play()
			apply_ghost_mode_to_all()
	else:
		circular_bar.value = 0.0
		timer_label.text = \"0.0\"

func start_prep_phase(prep_seconds: float = 3.0) -> void:
	is_in_prep_phase = true
	cdSFX.play()
	if has_node(\"PrepLabel\"):
		$PrepLabel.show()
	for i in range(int(prep_seconds), 0, -1):
		if has_node(\"PrepLabel\"):
			$PrepLabel.text = \"Get Ready! \" + str(i)
		await get_tree().create_timer(1.0).timeout
	
	if has_node(\"PrepLabel\"):
		$PrepLabel.text = \"GO!\"
		await get_tree().create_timer(0.5).timeout
		$PrepLabel.hide()

	is_in_prep_phase = false
	cdSFX.stop()

func start_new_game() -> void:
	circular_bar.min_value = 0.0
	circular_bar.max_value = default_game_time
	circular_bar.value = default_game_time
	
	timer.wait_time = default_game_time
	timer.start(default_game_time)
	timer_label.show()
	circular_bar.show()
	cards.show()
	results_panel.hide()
	
	is_ghost = false
	is_overdrive = false
	overdrive_time_left = 0.0
	streak = 0
	clears_since_shuffle = 0
	score = 0
	rounds = 1
	quota = base_quota
	base_points_per_correct = 100
	penalty_per_wrong = 25
	max_elements = 5
	start_x = 200.0
	start_y = 250.0
	correct_picks = 0
	overdrive_picks = 0
	wrong_picks = 0
	
	round_label.text = \"Round - \" + str(rounds)
	quota_label.text = \"Quota: \" + str(quota)
	reset_button_positions()
	update_streak_ui()
	update_notes_ui()
	
	for i in range(max_elements):
		spawn_element()

func next_game() -> void:
	rounds += 1
	round_label.text = \"Round - \" + str(rounds)
	
	# Round difficulty escalation: shrink lookahead queue & enable permanent Ghost Mode at Round 4+
	if rounds >= 4:
		is_ghost = true
		max_elements = 3
		start_x = 340.0
		start_y = 250.0
	elif rounds == 3:
		is_ghost = false
		max_elements = 4
		start_x = 340.0
		start_y = 250.0
	elif rounds == 2:
		is_ghost = false
		max_elements = 4
		start_x = 260.0
		start_y = 250.0
	else:
		is_ghost = false
		max_elements = 5
		start_x = 200.0
		start_y = 250.0
		
	timer.wait_time = default_game_time
	circular_bar.min_value = 0.0
	circular_bar.max_value = default_game_time
	circular_bar.value = default_game_time
	results_panel.hide()
	timer_label.show()
	circular_bar.show()
	cards.show()
	
	score = 0
	streak = 0
	clears_since_shuffle = 0
	correct_picks = 0
	overdrive_picks = 0
	wrong_picks = 0
	is_overdrive = false
	overdrive_time_left = 0.0
	reset_button_positions()
	update_streak_ui()
	update_notes_ui()
	
	# Scale quota and point values by 1.25x each round
	var multiplier: float = pow(1.25, rounds - 1)
	quota = roundi(base_quota * multiplier)
	base_points_per_correct = roundi(100 * multiplier)
	penalty_per_wrong = roundi(25 * multiplier)
	quota_label.text = \"Quota: \" + str(quota)
	
	for instance in active_queue:
		if is_instance_valid(instance):
			instance.queue_free()
	active_queue.clear()
	
	await start_prep_phase(3.0)
	timer.start(default_game_time)
	for i in range(max_elements):
		spawn_element()

# Queue Spawning & Modifiers
func spawn_element() -> void:
	var random = list.pick_random()
	if random == last_spawn and list.size() > 1:
		var choices = list.duplicate()
		choices.erase(last_spawn)
		random = choices.pick_random()
	last_spawn = random
	
	var instance = random.instantiate() as Node2D
	var sprite_node: Sprite2D = instance if instance is Sprite2D else instance.get_node_or_null(\"Sprite2D\")
	if sprite_node:
		if is_ghost and ghost_map.has(random):
			sprite_node.texture = ghost_map[random]
		elif normal_map.has(random):
			sprite_node.texture = normal_map[random]
	if ghost_map.has(random):
		instance.set_meta(\"ghost_texture\", ghost_map[random])
	add_child(instance)
	
	var element_str: String = \"\"
	for elem in [\"Fire\", \"Water\", \"Grass\", \"Divine\", \"Electric\", \"Dark\"]:
		if instance.is_in_group(elem):
			element_str = elem
			break
			
	apply_card_modifiers(instance, element_str)
	active_queue.append(instance)
	update_positions()

func apply_card_modifiers(card_node: Node2D, element_name: String) -> void:
	card_node.set_meta(\"element\", element_name)
	card_node.set_meta(\"hp\", 1)
	card_node.set_meta(\"is_reversed\", false)
	card_node.set_meta(\"is_time_bonus\", false)
	card_node.set_meta(\"base_scale\", Vector2.ONE)
	card_node.rotation_degrees = 0.0
	card_node.modulate = Color.WHITE
	
	var roll: float = randf()
	if rounds >= 2 and roll < reverse_chance:
		card_node.set_meta(\"is_reversed\", true)
		card_node.rotation_degrees = 180.0
		_start_reversed_anim(card_node)
	elif rounds >= 2 and roll < (reverse_chance + armor_chance):
		card_node.set_meta(\"hp\", 2)
		card_node.set_meta(\"base_scale\", Vector2(1.12, 0.92))
		card_node.modulate = Color(0.55, 0.55, 0.65)
	elif roll < (reverse_chance + armor_chance + time_bonus_chance):
		card_node.set_meta(\"is_time_bonus\", true)
		_start_time_bonus_anim(card_node)

func _start_reversed_anim(card_node: Node2D) -> void:
	var target: Node2D = card_node if card_node is Sprite2D else card_node.get_node_or_null(\"Sprite2D\")
	if target and target != card_node:
		var float_tween = card_node.create_tween().set_loops()
		float_tween.tween_property(target, \"position:y\", target.position.y - 10.0, 0.4).set_trans(Tween.TRANS_SINE)
		float_tween.tween_property(target, \"position:y\", target.position.y + 10.0, 0.4).set_trans(Tween.TRANS_SINE)
	else:
		var pulse_tween = card_node.create_tween().set_loops()
		pulse_tween.tween_property(card_node, \"skew\", 0.12, 0.35).set_trans(Tween.TRANS_SINE)
		pulse_tween.tween_property(card_node, \"skew\", -0.12, 0.35).set_trans(Tween.TRANS_SINE)

func _start_time_bonus_anim(card_node: Node2D) -> void:
	var glow_tween = card_node.create_tween().set_loops()
	glow_tween.tween_property(card_node, \"modulate\", Color(1.65, 1.55, 1.15), 0.35).set_trans(Tween.TRANS_SINE)
	glow_tween.tween_property(card_node, \"modulate\", Color(1.0, 1.0, 1.0), 0.35).set_trans(Tween.TRANS_SINE)
	
	var tilt_tween = card_node.create_tween().set_loops()
	tilt_tween.tween_property(card_node, \"rotation_degrees\", 8.0, 0.25).set_trans(Tween.TRANS_SINE)
	tilt_tween.tween_property(card_node, \"rotation_degrees\", -8.0, 0.25).set_trans(Tween.TRANS_SINE)

func apply_ghost_mode_to_all() -> void:
	for instance in active_queue:
		if is_instance_valid(instance) and instance.has_meta(\"ghost_texture\"):
			var new_tex = instance.get_meta(\"ghost_texture\")
			if instance is Sprite2D:
				instance.texture = new_tex
			elif instance.has_node(\"Sprite2D\"):
				instance.get_node(\"Sprite2D\").texture = new_tex

func update_positions() -> void:
	for i in range(active_queue.size()):
		var node = active_queue[i]
		if not is_instance_valid(node):
			continue
		var base_s: Vector2 = node.get_meta(\"base_scale\", Vector2.ONE)
		if i == 0:
			node.scale = base_s * 1.2
			node.position = Vector2(start_x, start_y - 15.0)
			node.z_index = 10
		else:
			node.scale = base_s
			node.position = Vector2(start_x + (i * spacing), start_y)
			node.z_index = 0

# Matching, Streaks & Overdrive
func process_furthest_left(played_element: String) -> void:
	if is_in_prep_phase or active_queue.is_empty():
		return
		
	var target_node = active_queue[0]
	var target_element: String = target_node.get_meta(\"element\")
	var is_rev: bool = target_node.get_meta(\"is_reversed\", false)
	
	# Overdrive bypasses type rules, breaks armor in 1 hit, and auto-clears
	if is_overdrive:
		_handle_match_success(target_node, true)
		return
	
	var required_element: String = LOSES_TO_MAP[target_element] if is_rev else BEATS_MAP[target_element]
	if played_element == required_element:
		var current_hp: int = target_node.get_meta(\"hp\", 1)
		if current_hp > 1:
			_handle_armor_crack(target_node, current_hp - 1)
		else:
			_handle_match_success(target_node, false)
	else:
		_handle_match_fail()

func _handle_armor_crack(target_node: Node2D, remaining_hp: int) -> void:
	target_node.set_meta(\"hp\", remaining_hp)
	target_node.set_meta(\"base_scale\", Vector2.ONE)
	target_node.modulate = Color.WHITE
	correctSFX.pitch_scale = 0.85
	correctSFX.play()
	
	var tween = create_tween()
	tween.tween_property(target_node, \"scale\", Vector2(1.4, 1.0), 0.06)
	tween.tween_property(target_node, \"scale\", Vector2(1.2, 1.2), 0.1)

func _handle_match_success(target_node: Node2D, overdrive_active: bool) -> void:
	correct_picks += 1
	streak += 1
	clears_since_shuffle += 1
	
	if overdrive_active:
		overdrive_picks += 1
		correctSFX.pitch_scale = 1.35
		score += base_points_per_correct * 2
	else:
		correctSFX.pitch_scale = 1.0 + (min(streak, 10) * 0.025)
		score += base_points_per_correct
		if streak >= overdrive_threshold:
			activate_overdrive()
			
	if target_node.get_meta(\"is_time_bonus\", false):
		add_time(time_bonus_amount)
			
	correctSFX.play()
	update_streak_ui()
	
	active_queue.pop_front()
	target_node.queue_free()
	
	while active_queue.size() < max_elements:
		spawn_element()
		
	update_positions()
	
	# Glitch mechanic: swap two buttons periodically in Round 3+, paused during Overdrive
	if rounds >= 3 and not is_overdrive and clears_since_shuffle >= shuffle_interval:
		clears_since_shuffle = 0
		shuffle_two_buttons()

func _handle_match_fail() -> void:
	wrong_picks += 1
	streak = 0
	wrongSFX.play()
	
	if is_overdrive:
		end_overdrive()
	else:
		update_streak_ui()
		
	deduct_time(2.0)

func shuffle_two_buttons() -> void:
	if slot_buttons.size() < 2:
		return
	var slot_a: int = randi() % slot_buttons.size()
	var slot_b: int = randi() % slot_buttons.size()
	while slot_b == slot_a:
		slot_b = randi() % slot_buttons.size()
		
	var btn_a: CardButton = slot_buttons[slot_a]
	var btn_b: CardButton = slot_buttons[slot_b]
	
	# Keep keys 1-6 synced to the new visual positions and preserve left-to-right draw overlap
	slot_buttons[slot_a] = btn_b
	slot_buttons[slot_b] = btn_a
	var idx_a: int = btn_a.get_index()
	var idx_b: int = btn_b.get_index()
	cards.move_child(btn_a, idx_b)
	cards.move_child(btn_b, idx_a)
	
	var pos_a: Vector2 = btn_a.position
	var pos_b: Vector2 = btn_b.position
	
	swapSFX.play()
	
	# Flash both the button and its child Sprite2D so button hover states don't override the yellow highlight
	for btn in [btn_a, btn_b]:
		btn.modulate = Color(1.8, 1.5, 0.2)
		btn.scale = Vector2(1.18, 1.18)
		var spr: Sprite2D = btn.get_node_or_null(\"Sprite2D\")
		if spr:
			spr.modulate = Color(1.8, 1.5, 0.2)
	
	var tween = create_tween().set_parallel(true).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(btn_a, \"position\", pos_b, 0.25)
	tween.tween_property(btn_b, \"position\", pos_a, 0.25)
	tween.tween_property(btn_a, \"modulate\", Color.WHITE, 0.55)
	tween.tween_property(btn_b, \"modulate\", Color.WHITE, 0.55)
	tween.tween_property(btn_a, \"scale\", Vector2.ONE, 0.25)
	tween.tween_property(btn_b, \"scale\", Vector2.ONE, 0.25)
	
	for btn in [btn_a, btn_b]:
		var spr: Sprite2D = btn.get_node_or_null(\"Sprite2D\")
		if spr:
			tween.tween_property(spr, \"modulate\", Color.WHITE, 0.55)

func reset_button_positions() -> void:
	slot_buttons = button_list.duplicate()
	for btn in button_list:
		if is_instance_valid(btn) and original_button_positions.has(btn):
			cards.move_child(btn, -1)
			btn.position = original_button_positions[btn]
			btn.modulate = Color.WHITE
			btn.scale = Vector2.ONE
			var spr: Sprite2D = btn.get_node_or_null(\"Sprite2D\")
			if spr:
				spr.modulate = Color.WHITE

func activate_overdrive() -> void:
	is_overdrive = true
	overdrive_time_left = overdrive_duration
	update_streak_ui()
	
	var tween = create_tween()
	tween.tween_property(color_rect, \"color\", Color(1.0, 0.75, 0.2, 0.15), 0.2)

func end_overdrive() -> void:
	is_overdrive = false
	overdrive_time_left = 0.0
	streak = 0
	update_streak_ui()
	
	var tween = create_tween()
	tween.tween_property(color_rect, \"color\", Color(0, 0, 0, 0), 0.3)

func add_time(seconds: float) -> void:
	if timer.is_stopped():
		return
	var new_time: float = min(timer.time_left + seconds, default_game_time)
	var tween = create_tween()
	timer_label.modulate = Color.GREEN
	tween.tween_property(timer_label, \"modulate\", Color.WHITE, 0.3)
	timer.start(new_time)

func deduct_time(seconds: float) -> void:
	if timer.is_stopped():
		return
	var new_time: float = timer.time_left - seconds
	var tween = create_tween()
	timer_label.modulate = Color.RED
	tween.tween_property(timer_label, \"modulate\", Color.WHITE, 0.3)
	
	if new_time <= 0.0:
		timer.stop()
		_on_timer_timeout()
	else:
		timer.start(new_time)

# UI, Animations & Results Tally
func update_notes_ui() -> void:
	if not is_instance_valid(note_label):
		return
	
	# Progressive reveal: dim modifiers until their unlock round
	var cw_color: String = \"#ffe64d\"
	var rev_color: String = \"#4de6ff\" if rounds >= 2 else \"#ffffff44\"
	var arm_color: String = \"#b3bfd9\" if rounds >= 2 else \"#ffffff44\"
	var ghost_color: String = \"#bf80ff\" if rounds >= 2 else \"#ffffff44\"
	
	note_label.text = (
		\"[color=%s]CLOCKWORK: +2.0s Time[/color]\\n\" % cw_color +
		\"[color=%s]REVERSED: Flip Matchup[/color]\\n\" % rev_color +
		\"[color=%s]ARMORED: 2 Hits[/color]\\n\" % arm_color +
		\"[color=%s]GHOST: Silhouette Only[/color]\" % ghost_color
	)

func update_streak_ui() -> void:
	if streak == 0 and not is_overdrive:
		streak_label.hide()
		return
		
	streak_label.show()
	streak_label.pivot_offset = streak_label.size / 2.0
	
	if is_overdrive:
		streak_label.text = \"OVERDRIVE! 2X\"
		streak_label.modulate = Color(1.0, 0.85, 0.1)
		_start_overdrive_pulse()
	else:
		_stop_overdrive_pulse()
		streak_label.text = \"STREAK: %dx\" % streak
		
		if streak >= 7:
			streak_label.modulate = Color(1.0, 0.45, 0.1)
		elif streak >= 4:
			streak_label.modulate = Color(0.2, 0.9, 1.0)
		else:
			streak_label.modulate = Color.WHITE
			
		_pop_streak_label(1.25)

func _pop_streak_label(target_scale: float = 1.25) -> void:
	var tween = create_tween()
	streak_label.scale = Vector2(target_scale, target_scale)
	tween.tween_property(streak_label, \"scale\", Vector2.ONE, 0.2).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

func _start_overdrive_pulse() -> void:
	if overdrive_pulse_tween and overdrive_pulse_tween.is_valid():
		return
	overdrive_pulse_tween = create_tween().set_loops()
	overdrive_pulse_tween.tween_property(streak_label, \"scale\", Vector2(1.2, 1.2), 0.15).set_trans(Tween.TRANS_SINE)
	overdrive_pulse_tween.tween_property(streak_label, \"scale\", Vector2(0.95, 0.95), 0.15).set_trans(Tween.TRANS_SINE)

func _stop_overdrive_pulse() -> void:
	if overdrive_pulse_tween:
		overdrive_pulse_tween.kill()
		overdrive_pulse_tween = null
	streak_label.scale = Vector2.ONE

func show_results_tally() -> void:
	timeSFX.stop()
	streak_label.hide()
	correct_label.text = \"Correct Picks: 0\"
	penalty_label.text = \"Wrong Penalty: 0\"
	last_round_label.text = \"Last Round: 0\"
	final_label.text = \"Total Score: 0\"
	results_panel.show()
	
	# Overdrive picks count double toward the tallied score
	var total_correct_pts = (correct_picks + overdrive_picks) * base_points_per_correct
	var total_penalty_pts = wrong_picks * penalty_per_wrong
	var last_round = rounds
	var final_score = max(0, total_correct_pts - total_penalty_pts)
	
	if final_score >= quota:
		button_label.text = \"Next Round\"
		next = true
		winSFX.play()
	else:
		button_label.text = \"New Game\"
		next = false
		failSFX.play()
	
	var sequence = create_tween().set_parallel(false)
	sequence.tween_method(
		func(val: int): correct_label.text = \"Correct Picks (%d): +%d\" % [correct_picks, val],
		0, total_correct_pts, 0.8
	).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	sequence.tween_callback(func(): pop_label(correct_label))
	sequence.tween_interval(0.3)
	
	sequence.tween_method(
		func(val: int): penalty_label.text = \"Wrong Penalty (%d): -%d\" % [wrong_picks, val],
		0, total_penalty_pts, 0.6
	).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	sequence.tween_callback(func(): pop_label(penalty_label))
	sequence.tween_interval(0.3)
	
	sequence.tween_method(
		func(val: int): last_round_label.text = \"Last Round: %d\" % val,
		0, last_round, 0.5
	).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	sequence.tween_callback(func(): pop_label(last_round_label))
	sequence.tween_interval(0.4)
	
	sequence.tween_method(
		func(val: int): final_label.text = \"FINAL SCORE: %d\" % val,
		0, final_score, 1.0
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	sequence.tween_callback(func(): pop_label(final_label, 1.3))

func pop_label(lbl: Label, scale_factor: float = 1.15) -> void:
	lbl.pivot_offset = lbl.size / 2.0
	var pop_tween = create_tween()
	pop_tween.tween_property(lbl, \"scale\", Vector2.ONE * scale_factor, 0.08)
	pop_tween.tween_property(lbl, \"scale\", Vector2.ONE, 0.12)

func animate_button_press(button: Control) -> void:
	var tween = create_tween().set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(button, \"scale\", Vector2(0.85, 0.85), 0.05)
	tween.tween_property(button, \"scale\", Vector2(1.1, 1.1), 0.15)

# Signals & Button Handlers
func _on_timer_timeout() -> void:
	timer.stop()
	timer_label.hide()
	circular_bar.hide()
	cards.hide()
	is_overdrive = false
	overdrive_time_left = 0.0
	_stop_overdrive_pulse()
	
	for node in active_queue:
		if is_instance_valid(node):
			node.queue_free()
	active_queue.clear()
	show_results_tally()
	is_ghost = false

func _on_retry_pressed() -> void:
	for node in active_queue:
		if is_instance_valid(node):
			node.queue_free()
	active_queue.clear()
	start_new_game()

func _on_final_button_pressed() -> void:
	if next:
		next_game()
	else:
		SceneTransition.change_scene(\"res://Scenes/main_menu.tscn\")

func _on_divine_b_pressed() -> void:
	animate_button_press(divine_b)
	process_furthest_left(\"Divine\")

func _on_dark_b_pressed() -> void:
	animate_button_press(dark_b)
	process_furthest_left(\"Dark\")

func _on_electric_b_pressed() -> void:
	animate_button_press(electric_b)
	process_furthest_left(\"Electric\")

func _on_fire_b_pressed() -> void:
	animate_button_press(fire_b)
	process_furthest_left(\"Fire\")

func _on_water_b_pressed() -> void:
	animate_button_press(water_b)
	process_furthest_left(\"Water\")

func _on_grass_b_pressed() -> void:
	animate_button_press(grass_b)
	process_furthest_left(\"Grass\")
"

