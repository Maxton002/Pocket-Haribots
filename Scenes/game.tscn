[sub_resource type="GDScript" id="GDScript_g2dxt"]
resource_name = "Main"
script/source = "extends Node2D

@onready var timer: Timer = $Timer
@onready var timer_label: Label = $TextureProgressBar/Label
@onready var circular_bar: TextureProgressBar = $TextureProgressBar

var babybuster = preload(\"res://Scenes/babybuster.tscn\")
var popstron = preload(\"res://Scenes/popstron.tscn\")
var siborg = preload(\"res://Scenes/siborg.tscn\")

@export var max_elements: int = 5
@export var spacing: float = 200.0
@export var start_x: float = 200.0  # X position of the furthest LEFT element
@export var start_y: float = 250.0  # Y position of the queue line

var list = [babybuster, popstron, siborg]
var active_queue: Array[Node2D] = []
var last_spawn = null
var score = 0

func _ready() -> void:
	# Set progress bar bounds to match timer duration
	circular_bar.max_value = timer.wait_time
	circular_bar.min_value = 0.0
	timer.start()
	for i in range(max_elements):
		spawn_element()

func _process(_delta: float) -> void:
	if not timer.is_stopped():
		var time_left: float = timer.time_left
		
		# 1. Update circular progress bar value
		circular_bar.value = time_left
		
		# 2. Update label text (formatted to 1 decimal place, e.g., \"5.2s\")
		timer_label.text = \"%.1f\" % time_left
	else:
		circular_bar.value = 0
		timer_label.text = \"0.0\"

func spawn_element() -> void:
	var random = list.pick_random()
	
	if random == last_spawn and list.size() > 1:
		var choices = list.duplicate()
		choices.erase(last_spawn)
		random = choices.pick_random()
	
	last_spawn = random
	
	var instance = random.instantiate() as Node2D
	add_child(instance)
	active_queue.append(instance)
	
	update_positions()

func update_positions() -> void:
	# Index 0 is placed at start_x (furthest left)
	# Subsequent items (1, 2, 3...) are placed further to the right
	for i in range(active_queue.size()):
		var target_x = start_x + (i * spacing)
		active_queue[i].position = Vector2(target_x, start_y)

func process_furthest_left(required_group: String) -> void:
	if active_queue.is_empty():
		print(\"DEBUG: active_queue is empty!\")
		return
		
	var leftmost_node = active_queue[0]
	
	# Print exact debug details when a button is clicked
	print(\"--- BUTTON CLICKED ---\")
	print(\"Button requested group: \", required_group)
	print(\"Leftmost Node Name: \", leftmost_node.name)
	print(\"Leftmost Node Groups: \", leftmost_node.get_groups())
	
	# Check children groups as well
	var child_groups = []
	for child in leftmost_node.get_children():
		child_groups.append_array(child.get_groups())
	print(\"Children Groups: \", child_groups)
	
	if node_has_group(leftmost_node, required_group):
		print(\"MATCH! Removing node.\")
		active_queue.remove_at(0)
		leftmost_node.queue_free()
		spawn_element()
	else:
		print(\"NO MATCH! The requested group was not found.\")
	print(\"----------------------\")

# Checks the root node OR any child node (Sprite2D, Area2D) for the group
func node_has_group(node: Node, group_name: String) -> bool:
	if node.is_in_group(group_name):
		return true
	for child in node.get_children():
		if child.is_in_group(group_name):
			return true
	return false

# Helper function to check if the node OR its Sprite2D child has the group
func has_group_recursive(node: Node, group_name: String) -> bool:
	if node.is_in_group(group_name):
		return true
	for child in node.get_children():
		if child.is_in_group(group_name):
			return true
	return false

# --- Button Handlers ---

func _on_pressed_1() -> void: # Fire > Grass
	process_furthest_left(\"Grass\")
	score += 1

func _on_pressed_2() -> void: # Water > Fire
	process_furthest_left(\"Fire\")
	score += 1

func _on_pressed_3() -> void: # Grass > Water
	process_furthest_left(\"Water\")
	score += 1


func _on_retry_pressed() -> void:
	for node in active_queue:
		if is_instance_valid(node):
			node.queue_free()
	active_queue.clear()
	
	for i in range(max_elements):
		spawn_element()


func _on_timer_timeout() -> void:
	timer.stop() # Replace with function body.
	# Loop through every node in active_queue and delete it
	for node in active_queue:
		if is_instance_valid(node):
			node.queue_free()
			
	# Clear the array so no references remain
	active_queue.clear()
	print(score)
"

